@model GuedesTime.MVC.ViewModels.UsuarioPerfilViewModel

<div class="modal-header">
	<div class="modal-title-container">
		<h3 class="modal-title">
			"Editar dados da Disciplina"
		</h3>

		<div class="info-tooltip-container">
			<i class="fas fa-info-circle info-icon"></i>
			<div class="info-tooltip-text tooltip-bottom">
				<h4 class="tooltip-title">Dica sobre a Edição de dados do Usuario</h4>
				<p>
					X <strong>X</strong> X<br><br>
					X.<br>
					X.
				</p>
			</div>
		</div>

	</div>
</div>

<form asp-area="" asp-controller="Usuario" asp-action="AtualizarDados" method="post" id="form-usuario-edit">
	@Html.AntiForgeryToken()
	<vc:summary />
	<div class="modal-body">
		<div class="form-group">
			<label asp-for="Nome" class="control-label campo-nome"></label>
			<input asp-for="Nome" class="form-control campo-nome" />
			<span asp-validation-for="Nome" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="CpfMascarado" class="control-label"></label>
			<div class="input-with-button">
				<input asp-for="CpfMascarado" class="form-control campo-cpf" id="cpf"
					   inputmode="numeric" autocomplete="off" placeholder="000.000.000-00" data-error-id="cpf-error" />
				<button type="button" class="clear-input-btn js-clear-input-btn" title="Limpar campo">
					<i class="fas fa-times-circle"></i>
				</button>
			</div>
			<span id="cpf-error" class="text-danger"></span>
			<span asp-validation-for="CpfMascarado" class="text-danger"></span>
		</div>
	</div>

	<div class="modal-footer">
		<button type="button" class="btn secondary-btn" data-modal-close>Cancelar</button>
		<button type="submit" class="btn primary-btn">Salvar</button>
	</div>
</form>

