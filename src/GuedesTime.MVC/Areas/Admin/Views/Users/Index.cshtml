@model List<GuedesTime.MVC.Areas.Admin.ViewModels.UserListItemVm>
@{
	ViewData["Title"] = "Usuários";
}

<div class="page-header">
	<h2>Usuários registrados</h2>
	<div style="display:flex; gap:12px;">
		<a class="btn secondary-btn" asp-area="Admin" asp-controller="Roles" asp-action="Index">
			<i class="fas fa-user-shield"></i> Roles
		</a>
	</div>
</div>

<div class="card">
	<div class="card-body">
		<table class="table" style="width:100%;">
			<thead>
				<tr>
					<th>Nome</th>
					<th>Email</th>
					<th>Roles</th>
					<th style="width:220px;">Ações</th>
				</tr>
			</thead>
			<tbody>
			@if (Model.Count == 0)
			{
				<tr><td colspan="4">Nenhum usuário encontrado.</td></tr>
			}
			else
			{
				foreach (var u in Model)
				{
					<tr>
						<td>@u.Nome</td>
						<td>@u.Email</td>
						<td>@(u.Roles.Count == 0 ? "-" : string.Join(", ", u.Roles))</td>
						<td>
							<a class="btn secondary-btn" asp-area="Admin" asp-controller="Users" asp-action="EditRoles" asp-route-id="@u.Id">
								<i class="fas fa-user-cog"></i> Roles
							</a>
						</td>
					</tr>
				}
			}
			</tbody>
		</table>
	</div>
</div>

